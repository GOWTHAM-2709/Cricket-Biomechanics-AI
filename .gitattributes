# ═══════════════════════════════════════════════════════════════════════════
# .gitattributes — Cricket AI Biomechanics & Speed Analyzer
# ═══════════════════════════════════════════════════════════════════════════
# Purpose:
#   Controls how Git handles line endings (LF vs CRLF) and diff behaviour
#   for every file type in this Spring Boot + Maven + Docker + GitHub project.
#
# Core rule:
#   text=auto  → Git auto-detects text files and normalises line endings.
#                Files are stored with LF in the repository.
#                On checkout, Windows gets CRLF; Linux/macOS gets LF.
#
# Why this matters for CI/CD:
#   Jenkins runs on Windows for local builds but the Docker container
#   and AWS EC2 run Linux. Consistent LF in the repo prevents shell
#   scripts from breaking inside Docker with "\r: bad interpreter" errors.
# ═══════════════════════════════════════════════════════════════════════════

# ── Default: auto-detect and normalise all text files ────────────────────
* text=auto

# ── Java / Spring Boot source ─────────────────────────────────────────────
*.java        text eol=lf
*.xml         text eol=lf
*.properties  text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf

# ── Build & CI scripts ────────────────────────────────────────────────────
# Jenkinsfile must use LF — Groovy parser is LF-tolerant but Windows CRLF
# inside heredocs can cause "unexpected token" parse errors in Jenkins.
Jenkinsfile   text eol=lf

# Maven wrapper scripts:
#   mvnw       = Linux/macOS shell script — MUST be LF
#   mvnw.cmd   = Windows batch file — MUST be CRLF on Windows checkout
mvnw          text eol=lf
mvnw.cmd      text eol=crlf
*.sh          text eol=lf
*.bat         text eol=crlf
*.cmd         text eol=crlf

# ── Docker ────────────────────────────────────────────────────────────────
# Dockerfiles run inside Linux containers — always LF.
Dockerfile*   text eol=lf
.dockerignore text eol=lf

# ── Web / Frontend ────────────────────────────────────────────────────────
*.html        text eol=lf
*.css         text eol=lf
*.js          text eol=lf
*.json        text eol=lf

# ── Python AI Microservice ────────────────────────────────────────────────
# Python scripts run inside a Linux Docker container — must be LF.
*.py          text eol=lf
*.txt         text eol=lf

# ── Markdown / Documentation ──────────────────────────────────────────────
*.md          text eol=lf

# ── Git internals ─────────────────────────────────────────────────────────
.gitattributes text eol=lf
.gitignore     text eol=lf

# ── True binary files — never touch line endings ──────────────────────────
# Marking as binary tells Git: do not attempt diff, merge, or CRLF conversion.
*.jar         binary
*.war         binary
*.class       binary
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.mp4         binary
*.avi         binary
*.mov         binary
*.zip         binary
*.gz          binary
*.tar         binary
